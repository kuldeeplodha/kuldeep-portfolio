# Admin gate for /admin configuration panel (optional — omit to disable admin)
# The app compares a SHA-256 hash, so the plaintext password never lands in the
# public bundle. Generate the hex digest for your password with:
#   echo -n 'your-password' | shasum -a 256
# Copy to .env.local and set your own hash — never commit .env.local
VITE_ADMIN_PASSWORD_HASH=your-sha256-hex-digest-here

# GitHub Pages base path (optional)
# VITE_BASE_PATH=/kuldeep-portfolio/

# V2.2 content backend (FastAPI + Turso, see backend/README.md). Only needed
# to use the Blog Posts / Case Studies admin tabs — local dev default shown.
# VITE_API_BASE_URL=http://localhost:8000

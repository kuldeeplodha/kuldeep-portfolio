{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/content(.*)",
      "dest": "main.py",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate, s-maxage=60"
      }
    },
    {
      "src": "/api/(case-studies|blogs)(.*)",
      "dest": "main.py",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate, s-maxage=300"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "main.py"
    }
  ]
}
